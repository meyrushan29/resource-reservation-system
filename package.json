{
  "name": "resource-reservation-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:reset": "dotenv -e .env.test -- tsx scripts/reset-test-db.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "npm run db:test:reset && dotenv -e .env.test -- vitest run --project integration --no-file-parallelism",
    "test:e2e": "npm run db:test:reset && playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
