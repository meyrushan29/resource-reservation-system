        <mxCell id="c189" value="&lt;b&gt;enum ReservationStatus&lt;/b&gt;&lt;br&gt;CONFIRMED&lt;br&gt;CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="c190" value="&lt;b&gt;reservations_no_overlap&lt;/b&gt; (EXCLUDE USING gist, btree_gist)&lt;br&gt;(resource_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &amp;amp;&amp;amp;)&lt;br&gt;WHERE status = 'CONFIRMED'&lt;br&gt;&lt;br&gt;Same resource + overlapping half-open time range is rejected.&lt;br&gt;Back-to-back bookings and CANCELLED rows never block." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="460" height="120" as="geometry"/></mxCell>
        <mxCell id="c191" value="No User table: the app has no authentication.&lt;br&gt;Requester name/email are stored on each reservation." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="420" height="50" as="geometry"/></mxCell>
