// Resource Reservation Management System — paste into https://dbdiagram.io
// Mirrors prisma/schema.prisma and prisma/migrations.

Enum resource_type {
  MEETING_ROOM
  CONFERENCE_ROOM
  TRAINING_ROOM
  WORKSPACE
  EQUIPMENT
  OTHER
}

Enum reservation_status {
  CONFIRMED
  CANCELLED
}

Table resources {
  id uuid [pk]
  name varchar(100) [not null, unique]
  description varchar(500)
  type resource_type [not null]
  location varchar(100)
  capacity int [note: 'CHECK (capacity IS NULL OR capacity > 0)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    type
    is_active
  }
}

Table reservations {
  id uuid [pk]
  number int [not null, unique, increment, note: 'Displayed as RSV-000042']
  resource_id uuid [not null, ref: > resources.id]
  requester_name varchar(100) [not null]
  requester_email varchar(254)
  purpose varchar(200) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'CHECK (ends_at > starts_at)']
  status reservation_status [not null, default: 'CONFIRMED']
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (resource_id, starts_at)
    starts_at
    (status, starts_at)
    updated_at
  }

  Note: '''
  EXCLUDE USING gist (resource_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &&)
  WHERE (status = 'CONFIRMED')  -- reservations_no_overlap, requires btree_gist
  Foreign key resource_id: ON DELETE RESTRICT
  '''
}
